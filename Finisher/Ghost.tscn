[sub_resource type="GDScript" id=2]
script/source = "extends AnimatedSprite2D

func _ready():
	ghosting()
	pass
	
func set_ghost_property(tx_pos, tx_scale):
	position = tx_pos
	scale = tx_scale	

func ghosting():
	var tween_fade = get_tree().create_tween()
	tween_fade.tween_property(self, \"self_modulate\",Color(1,1,0),0.75)
	await get_tree().create_timer(0.3).timeout
	#await tween_fade.finished
	queue_free()
"

